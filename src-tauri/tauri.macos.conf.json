{
  "build": {
    "beforeBuildCommand": "npm run build && cargo build --release --bin cs-bridge --manifest-path src-tauri/Cargo.toml"
  },
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "resources": {
      "target/release/cs-bridge": "cs-bridge"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
