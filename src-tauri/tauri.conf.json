{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ContextSwitch",
  "version": "0.1.0",
  "identifier": "app.contextswitch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && cargo build --release --bin cs-bridge --manifest-path src-tauri/Cargo.toml",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ContextSwitch · Ajustes",
        "width": 920,
        "height": 680,
        "minWidth": 760,
        "minHeight": 560,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "target/release/cs-bridge.exe": "cs-bridge.exe" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
